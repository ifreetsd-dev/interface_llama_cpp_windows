use crate::config::{AppData, LlamaConfig, RunMode};
use crate::logger::{self, Level};
use crate::process::ProcessManager;
use crate::vram::{get_vram_usage, VramInfo};
use crossbeam_channel::Receiver;
use eframe::egui;
use egui::{ScrollArea, ComboBox};
use std::collections::VecDeque;
use std::sync::Arc;
use std::path::PathBuf;
use std::time::Instant;

const MAX_LOGS: usize = 3000;

pub struct LlamaApp {
    data: AppData,
    data_path: PathBuf,
    process: Arc<ProcessManager>,
    log_rx: Receiver<String>,
    logs: VecDeque<String>,
    active_tab: String,
    prompt_input: String,
    model_list: Vec<String>,
    model_filter: String,
    new_config_name: String,
    status_msg: String,
    vram: VramInfo,
    vram_last_update: Instant,
    show_profiles: bool,
    selected_model: String,
}

impl LlamaApp {
    pub fn new(_cc: &eframe::CreationContext<'_>) -> Self {
        logger::init();
        
        let exe_dir = std::env::current_exe()
            .ok()
            .and_then(|p| p.parent().map(|p| p.to_path_buf()))
            .unwrap_or_else(|| PathBuf::from("."));
        let path = exe_dir.join("app_data.json");
        
        let data = match AppData::load(&path) {
            Ok(d) => d,
            Err(e) => {
                logger::log(Level::Error, "config", &format!("Échec chargement config: {}", e));
                logger::log(Level::Info, "config", "Utilisation des valeurs par défaut");
                AppData::default()
            }
        };
        
        let (tx, rx) = crossbeam_channel::unbounded();

        let mut app = Self {
            data, data_path: path,
            process: Arc::new(ProcessManager::new(tx)),
            log_rx: rx,
            logs: VecDeque::with_capacity(MAX_LOGS),
            active_tab: "Tous".into(),
            prompt_input: String::new(),
            model_list: Vec::new(),
            model_filter: String::new(),
            new_config_name: String::new(),
            status_msg: "Prêt".to_string(),
            vram: VramInfo::default(),
            vram_last_update: Instant::now(),
            show_profiles: false,
            selected_model: String::new(),
        };
        app.scan_models();
        logger::log(Level::Info, "ui", "Application initialisée");
        app
    }

    fn add_log(&mut self, msg: impl Into<String>) {
        self.logs.push_back(msg.into());
        if self.logs.len() > MAX_LOGS { self.logs.pop_front(); }
    }

    fn scan_models(&mut self) -> bool {
        self.model_list.clear();
        
        if self.data.paths.model_dir.is_empty() {
            logger::log(Level::Warn, "ui", "Répertoire modèles non configuré");
            return false;
        }
        
        let model_dir = std::path::Path::new(&self.data.paths.model_dir);
        if !model_dir.exists() {
            logger::log(Level::Warn, "ui", &format!("Répertoire introuvable: {}", self.data.paths.model_dir));
            return false;
        }
        
        if let Ok(entries) = std::fs::read_dir(model_dir) {
            for e in entries.filter_map(|e| e.ok()) {
                if let Some(p) = e.path().to_str() {
                    if p.ends_with(".gguf") { self.model_list.push(p.to_string()); }
                }
            }
        }
        self.model_list.sort();
        let count = self.model_list.len();
        logger::log(Level::Info, "ui", &format!("{} modèles trouvés", count));
        count > 0
    }

    fn save(&mut self) {
        if let Err(e) = self.data.save(&self.data_path) {
            self.status_msg = format!("❌ Erreur: {}", e);
        } else { 
            self.status_msg = "✅ Sauvegardé".to_string(); 
        }
    }

    fn load_config(&mut self, name: String) {  // ← Prend String, pas &str
        if self.data.configs.contains_key(&name) {
            self.data.active_config = Some(name.clone());
            self.add_log(format!("📂 Config '{}' chargée", name));
        }
    }

    fn delete_config(&mut self, name: String) {  // ← Prend String, pas &str
        self.data.configs.remove(&name);
        if self.data.active_config.as_deref() == Some(&name) { 
            self.data.active_config = None; 
        }
        self.save();
        self.add_log(format!("🗑️ '{}' supprimée", name));
    }
}

impl eframe::App for LlamaApp {
    fn update(&mut self, ctx: &egui::Context, _frame: &mut eframe::Frame) {
        while let Ok(line) = self.log_rx.try_recv() {
            self.add_log(line);
            ctx.request_repaint();
        }

        if self.vram_last_update.elapsed().as_secs() >= 1 {
            self.vram = match get_vram_usage() {
                Ok(v) => v,
                Err(e) => {
                    let err_msg = format!("{}", e);
                    logger::log(Level::Error, "vram", &err_msg);
                    VramInfo::default()
                }
            };
            self.vram_last_update = Instant::now();
        }

        // === PANNEAU GAUCHE ===
        egui::SidePanel::left("left").default_width(240.0).show(ctx, |ui| {
            ui.heading("📋 Configurations");
            
            ComboBox::from_id_source("cfg_sel")
                .selected_text(self.data.active_config.as_deref().unwrap_or("Aucune"))
                .show_ui(ui, |ui: &mut egui::Ui| {
                    for name in self.data.configs.keys() {
                        ui.selectable_value(&mut self.data.active_config, Some(name.clone()), name);
                    }
                });
                
            ui.horizontal(|ui| {
                // Clone avant d'appeler les méthodes mutables
                if ui.button("📥 Charger").clicked() { 
                    if let Some(n) = &self.data.active_config { 
                        self.load_config(n.clone()); 
                    } 
                }
                if ui.button("🗑️ Suppr").clicked() { 
                    if let Some(n) = &self.data.active_config { 
                        self.delete_config(n.clone()); 
                    } 
                }
            });
            
            ui.separator();
            ui.text_edit_singleline(&mut self.new_config_name);
            if ui.button("➕ Créer").clicked() {
                let n = self.new_config_name.clone().trim().to_string();
                if !n.is_empty() {
                    let mut cfg = LlamaConfig::default(); 
                    cfg.name = n.clone();
                    self.data.configs.insert(n.clone(), cfg);
                    self.data.active_config = Some(n.clone());
                    self.new_config_name.clear();
                    self.save();
                    self.add_log(&format!("✅ Config '{}' créée", n));
                }
            }
            
            ui.separator();
            if ui.button("📦 Profils prédéfinis").clicked() { 
                self.show_profiles = !self.show_profiles; 
            }
            if self.show_profiles {
                ui.group(|ui| {
                    for name in ["💬 Chat Rapide", "💻 Low VRAM", "📜 Contexte Max"] {
                        if ui.button(name).clicked() { 
                            self.load_config(name.to_string()); 
                            self.show_profiles = false; 
                        }
                    }
                });
            }
        });

// === PANNEAU CENTRAL : Paramètres ===
egui::CentralPanel::default().show(ctx, |ui| {
    ui.heading("⚙️ Paramètres");
    
    // Répertoire modèles
    ui.horizontal(|ui| {
        ui.label("Répertoire modèles:");
        ui.text_edit_singleline(&mut self.data.paths.model_dir);
        if ui.button("📂").clicked() {
            if let Some(f) = rfd::FileDialog::new().pick_folder() {
                self.data.paths.model_dir = f.display().to_string();
                self.save();
                self.scan_models();
            }
        }
        if ui.button("🔍").clicked() { 
            let found = self.scan_models();
            if !found {
                self.status_msg = "⚠️ Aucun modèle trouvé".to_string();
            } else {
                self.status_msg = "✅ Modèles scannés".to_string();
            }
        }
    });
    
    // Liste des modèles disponibles
    if !self.model_list.is_empty() {
        ui.horizontal(|ui| {
            ui.label(format!("📁 {} modèles:", self.model_list.len()));
            if ui.button("🔄").clicked() {
                self.scan_models();
            }
        });
        
        let models: Vec<String> = self.model_list.clone();
        let mut clicked_model: Option<String> = None;
        
        ScrollArea::horizontal().max_height(40.0).show(ui, |ui| {
            for m in &models {
                let display = m.split('/').next_back().unwrap_or(m);
                if ui.button(display).clicked() {
                    clicked_model = Some(m.clone());
                }
            }
        });
        
        if let Some(m) = clicked_model {
            self.selected_model = m.clone();
            self.add_log(&format!("📁 Modèle: {}", m.split('/').next_back().unwrap_or(&m)));
        }
        
        if !self.selected_model.is_empty() {
            ui.label(format!("✅ Sélectionné: {}", self.selected_model.split('/').next_back().unwrap_or(&self.selected_model)));
        }
    } else {
        ui.label("💡 Cliquez sur 📂 ou entrez un répertoire puis 🔍");
    }
    
    ui.separator();
    
    // Exécutables globaux
    ui.heading("🔧 Exécutables");
    
    let edit_path = |ui: &mut egui::Ui, label: &str, path: &mut String| {
        ui.horizontal(|ui| {
            ui.label(label);
            ui.text_edit_singleline(path);
            if ui.button("📂").clicked() {
                if let Some(f) = rfd::FileDialog::new().pick_file() {
                    *path = f.display().to_string();
                }
            }
        });
    };
    
    edit_path(ui, "CLI CUDA:", &mut self.data.paths.cli_cuda);
    edit_path(ui, "CLI Vulkan:", &mut self.data.paths.cli_vulkan);
    edit_path(ui, "SRV CUDA:", &mut self.data.paths.server_cuda);
    edit_path(ui, "SRV Vulkan:", &mut self.data.paths.server_vulkan);
    
if ui.button("💾 Sauvegarder").clicked() {
        self.save();
        self.add_log("✅ Chemins sauvegardés");
    }
    
    ui.separator();
    
    let active_config_name = self.data.active_config.clone();
    
    if let Some(name) = active_config_name {
        if let Some(cfg) = self.data.configs.get(&name).cloned() {
            let mut mode = cfg.mode;
            let mut use_vulkan = cfg.use_vulkan;
            let mut ngl = cfg.ngl;
            let mut threads = cfg.threads;
            let mut ctx_size = cfg.ctx_size;
            let mut temperature = cfg.temperature;
            let mut max_tokens = cfg.max_tokens;
            let mut cache_k = cfg.cache_k.clone();
            let mut cache_v = cfg.cache_v.clone();
            let mut chat_template = cfg.chat_template.clone();
            let mut additional_args = cfg.additional_args.clone();
            let mut server_host = cfg.server_host.clone();
            let mut server_port = cfg.server_port;
            let mut server_parallel = cfg.server_parallel;
            
            ui.heading(format!("📋 {}", cfg.name));
            
            ui.horizontal(|ui| {
                ui.label("Mode:");
                let is_server = mode == RunMode::Server;
                if ui.selectable_label(is_server, "Serveur").clicked() {
                    mode = RunMode::Server;
                }
                if ui.selectable_label(!is_server, "CLI").clicked() {
                    mode = RunMode::Cli;
                }
                ui.checkbox(&mut use_vulkan, "Vulkan");
            });

            ui.add(egui::Slider::new(&mut ngl, -1..=100).text("GPU (-1=all)"));
            ui.add(egui::Slider::new(&mut threads, 1..=32).text("Threads"));
            ui.add(egui::Slider::new(&mut ctx_size, 512..=32768).logarithmic(true).text("Contexte"));
            ui.add(egui::Slider::new(&mut temperature, 0.0..=2.0).text("Température"));
            ui.add(egui::Slider::new(&mut max_tokens, 1..=4096).text("Tokens"));

            ui.collapsing("Avancés", |ui| {
                ui.horizontal(|ui| { ui.label("Cache K:"); ui.text_edit_singleline(&mut cache_k); ui.label("Cache V:"); ui.text_edit_singleline(&mut cache_v); });
                ui.text_edit_singleline(&mut chat_template);
                ui.text_edit_multiline(&mut additional_args);
                
                if mode == RunMode::Server {
                    ui.separator();
                    ui.horizontal(|ui| { ui.label("Hôte:"); ui.text_edit_singleline(&mut server_host); ui.label("Port:"); ui.add(egui::DragValue::new(&mut server_port)); });
                    ui.add(egui::Slider::new(&mut server_parallel, 1..=16).text("Parallèle"));
                }
            });

            if ui.button("💾 Appliquer").clicked() {
                if let Some(name) = self.data.active_config.clone() {
                    let mut updated_cfg = cfg;
                    updated_cfg.mode = mode;
                    updated_cfg.use_vulkan = use_vulkan;
                    updated_cfg.ngl = ngl;
                    updated_cfg.threads = threads;
                    updated_cfg.ctx_size = ctx_size;
                    updated_cfg.temperature = temperature;
                    updated_cfg.max_tokens = max_tokens;
                    updated_cfg.cache_k = cache_k;
                    updated_cfg.cache_v = cache_v;
                    updated_cfg.chat_template = chat_template;
                    updated_cfg.additional_args = additional_args;
                    updated_cfg.server_host = server_host;
                    updated_cfg.server_port = server_port;
                    updated_cfg.server_parallel = server_parallel;
                    
                    self.data.configs.insert(name, updated_cfg);
                    self.save();
                    self.add_log("✅ Config appliquée");
                }
            }
        }
    } else {
        ui.label("⚠️ Sélectionnez une config à gauche");
    }
});

        // === PANNEAU BAS ===
        egui::TopBottomPanel::bottom("bottom").default_height(220.0).show(ctx, |ui| {
            ui.horizontal(|ui| {
                let process = Arc::clone(&self.process);
                let active_cfg = self.data.active_config.as_ref()
                    .and_then(|n| self.data.configs.get(n).cloned());
                let paths = self.data.paths.clone();
                
                ui.group(|ui| {
                    ui.label("CLI");
                    let running = futures::executor::block_on(process.is_cli_running());
                    if ui.button(if running { "⏹️ Arrêter CLI" } else { "▶️ Exécuter CLI" }).clicked() {
                        let proc = process.clone();
                        let cfg = active_cfg.clone();
                        let pths = paths.clone();
                        tokio::spawn(async move {
                            if running { let _ = proc.stop_cli().await; }
                            else if let Some(c) = cfg { let _ = proc.start(&c, &pths).await; }
                        });
                    }
                });

                ui.group(|ui| {
                    ui.label("SERVEUR");
                    let running = futures::executor::block_on(process.is_server_running());
                    if ui.button(if running { "⏹️ Arrêter Serveur" } else { "▶️ Exécuter Serveur" }).clicked() {
                        let proc = process.clone();
                        let cfg = active_cfg.clone();
                        let pths = paths.clone();
                        tokio::spawn(async move {
                            if running { let _ = proc.stop_server().await; }
                            else if let Some(c) = cfg { let _ = proc.start(&c, &pths).await; }
                        });
                    }
                });

                if let Some(cfg) = self.data.active_config.as_ref()
                    .and_then(|n| self.data.configs.get(n)) 
                {
                    if cfg.mode == RunMode::Cli {
                        let cli_running = futures::executor::block_on(process.is_cli_running());
                        if cli_running {
                            ui.separator();
                            ui.label("Prompt:");
                            ui.text_edit_singleline(&mut self.prompt_input);
                            if ui.button("➤").clicked() && !self.prompt_input.is_empty() {
                                process.send_cli_prompt(&self.prompt_input);
                                self.add_log(format!("[Vous] {}", self.prompt_input));
                                self.prompt_input.clear();
                            }
                        }
                    }
                }

                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
                    let color = if self.vram.total_mb > 0 {
                        let pct = self.vram.used_mb as f32 / self.vram.total_mb as f32;
                        if pct > 0.9 { egui::Color32::RED } 
                        else if pct > 0.7 { egui::Color32::YELLOW } 
                        else { egui::Color32::GREEN }
                    } else { egui::Color32::GRAY };
                    
                    ui.colored_label(color, format!(
                        "🎮 {} | VRAM: {}/{} MB (Libre: {})", 
                        self.vram.gpu_name, 
                        self.vram.used_mb, 
                        self.vram.total_mb,
                        self.vram.free_mb
                    ));
                    ui.label(&self.status_msg);
                });
            });

            ui.separator();
            ui.horizontal(|ui| {
                ui.selectable_value(&mut self.active_tab, "Tous".to_string(), "📜 Tous");
                ui.selectable_value(&mut self.active_tab, "CLI".to_string(), "💬 CLI");
                ui.selectable_value(&mut self.active_tab, "SRV".to_string(), "🌐 Serveur");
                if ui.button("🗑️ Effacer logs").clicked() { self.logs.clear(); }
            });
            
            ScrollArea::vertical().show(ui, |ui| {
                let prefix = match self.active_tab.as_str() {
                    "CLI" => "[CLI]",
                    "SRV" => "[SRV]",
                    _ => ""
                };
                for line in &self.logs {
                    if prefix.is_empty() || line.starts_with(prefix) {
                        ui.monospace(line);
                    }
                }
            });
        });
    }
}